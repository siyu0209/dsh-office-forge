{
  "name": "dsh-office-forge",
  "version": "3.5.9",
  "description": "Office Forge — configurable Word/Excel/PowerPoint/PDF toolkit with Deck IR, pluggable PPT adapters, real Guizang HTML decks, mandatory PPT intake, and Template Pack validation.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./skills/*": "./skills/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/*.js",
    "lib/*.mjs",
    "lib/*.py",
    "lib/vendor/**",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "docs/*.md",
    "benchmarks/*.py",
    "benchmarks/baseline.json",
    "scripts/*.py",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "resources/*.json",
    "resources/packs/**",
    "skills"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "dsh-ppt": "0.33.0",
    "dsh-ppt-studio": "1.2.7"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": false
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "office",
    "docx",
    "xlsx",
    "pptx",
    "template",
    "automation"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.5"
  },
  "author": "Office Forge Contributors",
  "publishConfig": {
    "access": "public"
  }
}
